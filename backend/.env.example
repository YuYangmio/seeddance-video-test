# ---- 方舟 OpenAPI ----
# 使用火山引擎 IAM 长期 AK/SK：只填 VOLCENGINE_ACCESS_KEY / VOLCENGINE_SECRET_KEY
# 使用 API Explorer 临时凭证：还需填 VOLCENGINE_SESSION_TOKEN
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
# VOLCENGINE_SESSION_TOKEN=
ARK_REGION=cn-beijing

# ---- 权限 / 鉴权 ----
# AUTH_MODE=simple: 使用 X-Admin-Token 头匹配 VERIFY_ADMIN_TOKEN (独立部署/本地开发)
# AUTH_MODE=system: 与现有系统 Cookie 会话对齐（需接入后启用 requireAuthentication）
AUTH_MODE=simple
VERIFY_ADMIN_TOKEN=please_change_this_to_a_random_long_string

# ---- CORS 跨域白名单（逗号分隔） ----
# 开发模式（NODE_ENV=development）下：留空即可，会自动放行 localhost/127.0.0.1 任意端口，
#   因此你改 VITE_PORT=3000/8080/任意都不会被 CORS 卡住。
# 生产模式（NODE_ENV=production）下：
#   - 留空 -> 仅允许同源（BFF 和前端同一个域名/反代）
#   - 配置源 -> 严格按列表放行，如 "https://verify.example.com,https://admin.example.com"
#   - 极端场景写 "*" 来开启全通配（不推荐）
# CORS_ORIGINS=

# ---- 服务配置 ----
# BFF 监听端口（与前端 VITE_BFF_PORT 对齐）
PORT=8787