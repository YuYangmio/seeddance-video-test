# ============================================================
#  ECS 源码部署环境变量模板（无需 Docker 方案）
#  —— 复制为 .env 后填入真实值：cp .env.example .env
# ============================================================

# ---------- 火山方舟（鉴伪 API，管理接口，IAM AK/SK）----------
# 获取地址：https://console.volcengine.com/iam/keymanage
VOLCENGINE_ACCESS_KEY=your_volcengine_access_key
VOLCENGINE_SECRET_KEY=your_volcengine_secret_key

# 【可选】仅当使用「临时凭证」(STS) 时填写，长期 AK/SK 留空即可
# VOLCENGINE_SESSION_TOKEN=your_session_token

# 方舟区域，目前只有 cn-beijing
ARK_REGION=cn-beijing

# ---------- 管理员鉴权 ----------
# 模式：simple(管理员 Token 模式) / system(预留飞书身份)
AUTH_MODE=simple
# simple 模式必填，建议使用 `openssl rand -hex 32` 生成强随机字符串
VERIFY_ADMIN_TOKEN=please_change_me_to_a_strong_random_string

# ---------- 服务配置 ----------
# 对外监听端口（ECS 安全组需放行此端口 TCP 入方向 0.0.0.0/0）
APP_PORT=8787
NODE_ENV=production

# ---------- 【可选】CORS 白名单 ----------
# 逗号分隔，不填则默认回显 Origin（同源/反向代理部署可不填）
# 示例：CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=
