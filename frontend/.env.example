# ---- 前端 dev server 监听端口 ----
# 默认 5173；任意修改不会影响代码逻辑（代理目标 VITE_BFF_PORT 同步对即可）
VITE_PORT=5173

# ---- 后端 BFF 地址（用于 dev 代理：/vendor /verify /health）----
# Vite 会把 API 请求转发到 http://<VITE_BFF_HOST>:<VITE_BFF_PORT>
VITE_BFF_HOST=http://127.0.0.1
VITE_BFF_PORT=8787

# ---- 端口占用时的行为 ----
# true  = 严格模式（占用即报错退出，避免漂移到 5175 导致白名单错位）
# false = Vite 默认行为（占用自动 +1）
VITE_STRICT_PORT=true
